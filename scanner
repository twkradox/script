-- Función para abreviar (5.54M)
local function formatAbbreviated(number)
    local abbreviations = {"", "K", "M", "B", "T", "Qa", "Qi"}
    local index = 1
    local val = tonumber(number) or 0
    while val >= 1000 and index < #abbreviations do
        val = val / 1000
        index = index + 1
    end
    return string.format("%.2f%s", val, abbreviations[index])
end

-- Función para formato con puntos (5.543.043)
local function formatWithPoints(number)
    local formatted = tostring(math.floor(number))
    local k
    while true do
        formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1.%2')
        if k == 0 then break end
    end
    return formatted
end

